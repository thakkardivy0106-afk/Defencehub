{
  "manifest_version": 3,
  "name": "DefenceHub",
  "version": "1.1.0",
  "description": "Browser security extension identifying suspicious websites via URL analysis, brand impersonation detection, explainable risk scoring, and security guidance.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DefenceHub - Browser Security Analysis"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "engine.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
